process {

	errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
	maxRetries    = 1
	maxErrors     = '-1'

	resourceLimits = [cpus: 6, memory: 8.GB, time: 8.h]

	withLabel:process_low {
		cpus   = 1
		memory = { 6.GB * task.attempt }
		time   = { 4.h * task.attempt }
	}

	withLabel:process_mid {
		cpus = 2
		memory = { 6.GB * task.attempt }
		time = { 4.h * task.attempt}
	}

	withLabel:error_retry {
		errorStrategy = 'retry'
		maxRetries = 2
	}
}


// Benchmarking: per-task CPU, memory, I/O and runtime, written every run
trace {
	enabled   = true
	overwrite = true
	file      = "results/pipeline_info/trace.tsv"
	fields    = 'task_id,hash,name,status,exit,cpus,memory,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report {
	enabled   = true
	overwrite = true
	file      = "results/pipeline_info/report.html"
}
timeline {
	enabled   = true
	overwrite = true
	file      = "results/pipeline_info/timeline.html"
}

profiles {
	local {
		docker.enabled    = true
		// Apple Silicon: most bioinformatics images are amd64-only; run them under emulation
		docker.runOptions = '--platform linux/amd64'
	}
	cluster {process.executor = 'slurm'; apptainer.enabled = true }
}


